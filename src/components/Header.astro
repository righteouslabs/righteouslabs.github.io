---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/">
      <img src="/favicon.svg" alt="" width="30" height="30" />
      Righteous&nbsp;AI
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="/" aria-current={isActive('/') ? 'page' : undefined}>Home</a>
      <a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a>
      <a href="/blog" aria-current={isActive('/blog') ? 'page' : undefined}>Blog</a>
      <a class="btn btn--primary nav-cta" href="/contact">Contact</a>
    </nav>
  </div>
</header>
